# SEO artifacts
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# HTML pages (root, directory indices, direct .html requests).
# Browser: must revalidate (max-age=0). Edge: cache 10 minutes (s-maxage=600).
# IMPORTANT: Cloudflare Pages treats text/html as Dynamic by default. You still need to create
# a Cache Rule in the Cloudflare dashboard (Caching > Cache Rules) to make HTML eligible for cache:
#   When incoming requests match: (http.host eq "www.erdonline.com") or (http.host eq "doc.erdonline.com")
#   Then: Eligible for cache
#   Edge TTL: Use cache-control header if present, bypass cache if not
/
  Cache-Control: public, max-age=0, s-maxage=600, must-revalidate

# Root .html files (e.g. index.html, 404.html)
/:file.html
  Cache-Control: public, max-age=0, s-maxage=600, must-revalidate

# Nested directory index.html files (e.g. /docs/guide/intro/index.html)
/*/:file.html
  Cache-Control: public, max-age=0, s-maxage=600, must-revalidate

# All extension-less directory index pages.
/*/
  Cache-Control: public, max-age=0, s-maxage=600, must-revalidate

# Images and other static assets.
/img/*
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate

# Root unhashed image-like assets: edge cache 1 day, browser must revalidate.
/:file.png
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate
/:file.jpg
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate
/:file.jpeg
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate
/:file.webp
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate
/:file.svg
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate
/:file.ico
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate
/:file.gif
  Cache-Control: public, max-age=0, s-maxage=86400, must-revalidate

# Docusaurus hashed assets (JS/CSS with content hash in filename): safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
