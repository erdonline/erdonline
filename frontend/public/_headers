# Cloudflare Pages: never cache runtime API injection
/env-config.js
  Cache-Control: no-store

# SEO artifacts (generated by scripts/gen-seo-static.mjs at build time)
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Umi content-hashed build output: safe to cache forever (new hash per deploy).
# Patterns avoid /env-config.js and /js/html2canvas.min.js (unhashed) to prevent
# header merging (CF Pages joins Cache-Control from multiple matching rules with a comma).
/umi.*.js
  Cache-Control: public, max-age=31536000, immutable
/umi.*.css
  Cache-Control: public, max-age=31536000, immutable
/preload_helper.*.js
  Cache-Control: public, max-age=31536000, immutable
/*.async.js
  Cache-Control: public, max-age=31536000, immutable
/*.chunk.css
  Cache-Control: public, max-age=31536000, immutable
