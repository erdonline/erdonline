# ===================================================================
# ERD-Online 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker-compose 会自动读取根目录 .env
# ===================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
# compose 宿主机端口映射（≠ App JDBC 的 MYSQLPORT）
MYSQL_PORT=3306
# App / Spring 直接读 Railway 插件名（单变量、无 DB_* 映射）：
#   MYSQLHOST MYSQLPORT MYSQLDATABASE MYSQLUSER MYSQLPASSWORD
# JDBC TLS（R-CFG-03）：MYSQL_USE_SSL / MYSQL_REQUIRE_SSL / MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL
#   本地/compose 默认关 SSL；prod/Railway 默认开（compose 已显式 MYSQL_USE_SSL=false）
# 本地默认库名 erd；Railway 插件常注入 MYSQLDATABASE=railway →
#   App 显式设 MYSQLDATABASE=erd 并跑 schema init，或对插件库灌 schema
# 不读 MYSQL_URL / SPRING_DATASOURCE_URL（双自定义 DS 前缀绑不上）
# 见 docs/deployment.md「Railway MySQL 正确接法」

# ---------- Redis ----------
# compose 宿主机端口映射（≠ App 的 REDISPORT）
REDIS_PORT=6379
# App / Spring：REDISHOST REDISPORT REDISUSER REDISPASSWORD（不读 REDIS_URL）
# 本地/compose 无密码：留空 REDISPASSWORD；Railway 插件注入 REDISPASSWORD（及可选 REDISUSER）

# ---------- Backend ----------
BACKEND_PORT=9502
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
# prod 必填；随机 ≥32 字节。禁止用 application.yml 仓库开发默认串（JwtConfig 拒）
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-compose-jwt-secret-min-32-chars!!!!
# prod 必填；OIDC id_token HS256；须 ≠ 仓库开发默认串、≠ JWT_SECRET 仓库串（可独立旋转）
# 生成示例：openssl rand -base64 48
ERD_OIDC_HMAC=change-me-compose-oidc-hmac-min-32-chars!!!!
# 可选；空则 issuer=ERD_UI_URL。本地直连 :9502 dogfood 时设 http://127.0.0.1:9502
# ERD_OIDC_ISSUER=
# prod 必填：UI Origin（CORS + SocketIO 同值）；禁止 *。compose 默认同源前端口
# 多源时可逗号分隔：https://a.example,https://b.example
ERD_UI_URL=http://localhost:8000
# 切勿在公网设为 true（允许 e2e0..e2e9 弱口令种子登录）
ERD_E2E_ACCOUNTS_ENABLED=false
# 切勿在公网设为 true（允许 admin/123456 种子口令登录）；prod 默认拒绝
ERD_ALLOW_DEMO_ADMIN=false
# 切勿在公网设为 true（允许匿名开放注册）；prod 默认拒绝；本地/E2E 靠 dev profile
ERD_ALLOW_OPEN_REGISTER=false
# 数据源（容器内通过服务名访问）；与 application.yml 占位符同名
MYSQLHOST=mysql
MYSQLPORT=3306
MYSQLDATABASE=erd
MYSQLUSER=erd
MYSQLPASSWORD=erd
# compose 内 MySQL 无 TLS；与 docker-compose 默认一致（prod profile 下也须关）
MYSQL_USE_SSL=false
MYSQL_REQUIRE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
REDISHOST=redis
REDISPORT=6379
REDISPASSWORD=
REDISUSER=

# ---------- OSS / MinIO（可选）----------
# 未设 OSS_ENDPOINT = 不启用对象存储；Word 自定义上传不可用，内置模板仍可导出
# 本地 MinIO 示例（仅 DX；prod 禁止 minio/minio123 — OssCredentialGuard 拒）
# OSS_ENDPOINT=http://localhost:9000
# OSS_ACCESS_KEY=minio
# OSS_SECRET_KEY=minio123

# ---------- Images (GHCR) ----------
# 默认拉取 ghcr.io/erdonline/erdonline-{backend,frontend}:${ERD_IMAGE_TAG}
# 本地改源码时：docker compose build backend frontend && docker compose up -d
ERD_IMAGE_TAG=latest

# ---------- Frontend ----------
FRONTEND_PORT=8000
# 前端运行时注入的后端 API 地址（浏览器可达）
# compose 内同源部署可留空（nginx 反代）；浏览器直连后端时填 http://localhost:9502
API_URL=
ERD_API_URL=
