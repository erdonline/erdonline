# ===================================================================
# ERD-Online 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker-compose 会自动读取根目录 .env
# ===================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
# 业务库（系统/OAuth 表）
MYSQL_DATABASE=martin
MYSQL_USER=martin
MYSQL_PASSWORD=martin
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=9502
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
# 数据源（容器内通过服务名访问）
DB_HOST=mysql
DB_PORT=3306
DB_MARTIN=martin
DB_ERD=erd
DB_USERNAME=martin
DB_PASSWORD=martin
REDIS_HOST=redis

# OAuth2 客户端（对应 db 中 oauth_client_details 表）
OAUTH_CLIENT_ID=client2
OAUTH_CLIENT_SECRET=123456

# ---------- Frontend ----------
FRONTEND_PORT=8000
# 前端运行时注入的后端 API 地址（浏览器可达）
API_URL=http://localhost:9502
ERD_API_URL=http://localhost:9502
