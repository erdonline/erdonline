# ===================================================================
# ERD-Online 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker-compose 会自动读取根目录 .env
# ===================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
# 业务库（系统/OAuth 表）
MYSQL_DATABASE=martin
MYSQL_USER=martin
MYSQL_PASSWORD=martin
MYSQL_PORT=3306
# Railway：App 须 Variable Reference MYSQLHOST/PORT/USER/PASSWORD → DB_HOST/…（或同名 MYSQL*）
# 手填 DB_MARTIN=martin、DB_ERD=erd；勿把插件 MYSQLDATABASE（常为 railway）当业务库
# 双库不读 MYSQL_URL / SPRING_DATASOURCE_URL；见 docs/deployment.md「Railway MySQL 正确接法」

# ---------- Redis ----------
REDIS_PORT=6379
# 本地 compose：docker-compose 设 REDIS_HOST=redis（无密码）。勿设空 password。
# Railway：App 变量名必须是 SPRING_DATA_REDIS_URL（Boot 松散绑定 → spring.data.redis.url）
#   值 = Variable Reference → Redis 插件的 REDIS_URL（私网，含账号密码）
#   裸 REDIS_URL 不会自动绑到 Spring；不要再依赖自定义 EnvironmentPostProcessor

# ---------- Backend ----------
BACKEND_PORT=9502
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
# 切勿在公网设为 true（允许 e2e0..e2e9 弱口令种子登录）
ERD_E2E_ACCOUNTS_ENABLED=false
# 数据源（容器内通过服务名访问）
DB_HOST=mysql
DB_PORT=3306
DB_MARTIN=martin
DB_ERD=erd
DB_USERNAME=martin
DB_PASSWORD=martin
REDIS_HOST=redis

# OAuth2 客户端（对应 db 中 oauth_client_details 表）
OAUTH_CLIENT_ID=client2
OAUTH_CLIENT_SECRET=123456

# ---------- Images (GHCR) ----------
# 默认拉取 ghcr.io/erdonline/erdonline-{backend,frontend}:${ERD_IMAGE_TAG}
# 本地改源码时：docker compose build backend frontend && docker compose up -d
ERD_IMAGE_TAG=latest

# ---------- Frontend ----------
FRONTEND_PORT=8000
# 前端运行时注入的后端 API 地址（浏览器可达）
# compose 内同源部署可留空（nginx 反代）；浏览器直连后端时填 http://localhost:9502
API_URL=
ERD_API_URL=

