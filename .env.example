# ===================================================================
# ERD-Online 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker-compose 会自动读取根目录 .env
# ===================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root
# compose 宿主机端口映射（≠ App JDBC 的 MYSQLPORT）
MYSQL_PORT=3306
# App / Spring 直接读 Railway 插件名（单变量、无 DB_* 映射）：
#   MYSQLHOST MYSQLPORT MYSQLDATABASE MYSQLUSER MYSQLPASSWORD
# JDBC TLS（R-CFG-03）：MYSQL_USE_SSL / MYSQL_REQUIRE_SSL / MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL
#   本地/compose 默认关 SSL；prod/Railway 默认开（compose 已显式 MYSQL_USE_SSL=false）
# 本地默认库名 erd；Railway 插件常注入 MYSQLDATABASE=railway →
#   App 显式设 MYSQLDATABASE=erd 并跑 schema init，或对插件库灌 schema
# 不读 MYSQL_URL / SPRING_DATASOURCE_URL（双自定义 DS 前缀绑不上）
# 见 docs/deployment.md「Railway MySQL 正确接法」

# ---------- Redis ----------
# compose 宿主机端口映射（≠ App 的 REDISPORT）
REDIS_PORT=6379
# App / Spring：REDISHOST REDISPORT REDISUSER REDISPASSWORD（不读 REDIS_URL）
# 本地/compose 无密码：留空 REDISPASSWORD；Railway 插件注入 REDISPASSWORD（及可选 REDISUSER）

# ---------- Backend ----------
BACKEND_PORT=9502
# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
# prod 必填；随机 ≥32 字节。禁止用 application.yml 仓库开发默认串（JwtConfig 拒）
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-compose-jwt-secret-min-32-chars!!!!
# prod 必填；data_sources.username/password 落库加密密钥（R-DATA-06，AES-256-GCM）
# 与 JWT_SECRET 分离、禁止复用；禁止用仓库开发默认串（DataSourceCredentialCipher 拒）
# 生成示例：openssl rand -base64 48
ERD_DB_CONFIG_SECRET=change-me-compose-datasource-secret-min-32-chars!!
# prod / compose 必填其一：OIDC id_token RS256（硬切，已废 ERD_OIDC_HMAC）
# 推荐：仓外 PEM 路径（compose 默认挂载 ./.secrets → /run/secrets/erd）
#   mkdir -p .secrets && openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -out .secrets/oidc-rsa-private.pem
# 或：ERD_OIDC_RSA_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----...'（整段 PEM）
# 或：ERD_OIDC_RSA_KEYSTORE_PATH + ERD_OIDC_RSA_KEYSTORE_PASSWORD + ERD_OIDC_RSA_KEY_ALIAS
ERD_OIDC_RSA_PRIVATE_KEY_PATH=/run/secrets/erd/oidc-rsa-private.pem
# 可选 JWK kid；空则公钥 thumbprint
# ERD_OIDC_RSA_KID=
# 可选；空则 issuer=ERD_UI_URL。本地直连 :9502 dogfood 时设 http://127.0.0.1:9502
# ERD_OIDC_ISSUER=
# prod 必填：UI Origin（CORS + SocketIO 同值）；禁止 *；无尾斜杠。compose 默认同源前端口
# 多源逗号分隔（Railway 官方 demo + 生产 UI 同后端时）：
# ERD_UI_URL=https://app.erdonline.com,https://www.erdonline.com
ERD_UI_URL=http://localhost:8000
# 切勿在公网设为 true（允许 e2e0..e2e9 弱口令种子登录）
ERD_E2E_ACCOUNTS_ENABLED=false
# 切勿在公网设为 true（允许 admin/123456 种子口令登录）；prod 默认拒绝
ERD_ALLOW_DEMO_ADMIN=false
# 切勿在公网设为 true（允许匿名开放注册）；prod 默认拒绝；本地/E2E 靠 dev profile
ERD_ALLOW_OPEN_REGISTER=false
# 数据源（容器内通过服务名访问）；与 application.yml 占位符同名
MYSQLHOST=mysql
MYSQLPORT=3306
MYSQLDATABASE=erd
MYSQLUSER=erd
MYSQLPASSWORD=erd
# compose 内 MySQL 无 TLS；与 docker-compose 默认一致（prod profile 下也须关）
MYSQL_USE_SSL=false
MYSQL_REQUIRE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
REDISHOST=redis
REDISPORT=6379
REDISPASSWORD=
REDISUSER=

# ---------- OSS / MinIO（可选）----------
# 未设 OSS_ENDPOINT = 不启用对象存储；Word 自定义上传不可用，内置模板仍可导出
# 本地 MinIO 示例（仅 DX；prod 禁止 minio/minio123 — OssCredentialGuard 拒）
# OSS_ENDPOINT=http://localhost:9000
# OSS_ACCESS_KEY=minio
# OSS_SECRET_KEY=minio123

# ---------- 第三方登录 IdP 联邦（ADR-0021，可选）----------
# 缺任一项 → 该 provider 关闭；不影响启动。勿把 secret 提交仓库。
# GitHub OAuth App：Authorization callback URL 须与 GITHUB_REDIRECT_URI 完全一致
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:9502/auth/federate/github/callback
# Google（OIDC）：控制台授权回调 URI 须与 GOOGLE_REDIRECT_URI 完全一致
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:9502/auth/federate/google/callback
# 微信开放平台「网站应用」扫码（snsapi_login）；授权回调域配主机（无 path）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=http://localhost:9502/auth/federate/wechat/callback
# 可选：回调成功后 UI 路径（默认 /login/federate；前缀为 ERD_UI_URL）
# ERD_FEDERATE_SUCCESS_PATH=/login/federate

# ---------- Images (GHCR) ----------
# 默认拉取 ghcr.io/erdonline/erdonline-{backend,frontend}:${ERD_IMAGE_TAG}
# 本地改源码时：docker compose build backend frontend && docker compose up -d
ERD_IMAGE_TAG=latest

# ---------- Growth / Wechatsync（可选，多平台草稿同步）----------
# 「文章同步助手」Chrome 扩展 → 设置 → MCP 连接 → 生成 Token（与扩展端一致）
# 未配置时 sync-wechatsync.mjs 会退出；--dry-run 可跳过
# WECHATSYNC_TOKEN=
# CLI ↔ 扩展 WebSocket 端口（默认 9527；远程桥接见 docs/growth.md）
# SYNC_WS_PORT=9527

# ---------- Frontend ----------
FRONTEND_PORT=8000
# 前端运行时注入的后端 API 地址（浏览器可达）
# compose 内同源部署可留空（nginx 反代）；浏览器直连后端时填 http://localhost:9502
API_URL=
ERD_API_URL=
