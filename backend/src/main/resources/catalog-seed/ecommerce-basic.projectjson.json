            {"name": "idx_shop_product_category", "isUnique": false, "fields": ["category_id"]}
          ]
        },
        {
          "title": "shop_category",
          "chnname": "分类",
          "fields": [
            {"name": "id", "chnname": "主键", "type": "IdOrKey", "pk": true, "notNull": true},
            {"name": "name", "chnname": "名称", "type": "MiddleString", "notNull": true},
            {"name": "parent_id", "chnname": "父分类", "type": "IdOrKey"}
          ],
          "indexs": [
            {"name": "uk_shop_category_name", "isUnique": true, "fields": ["name"]}
          ]
        },
        {
          "title": "shop_order",
          "chnname": "订单",
          "fields": [
            {"name": "id", "chnname": "主键", "type": "IdOrKey", "pk": true, "notNull": true},
            {"name": "order_no", "chnname": "订单号", "type": "MiddleString", "notNull": true},
            {"name": "user_id", "chnname": "用户", "type": "IdOrKey", "notNull": true},
            {"name": "total_amount", "chnname": "总额", "type": "Money", "notNull": true},
            {"name": "status", "chnname": "状态", "type": "ShortString", "defaultValue": "'pending'"},
            {"name": "create_time", "chnname": "创建时间", "type": "DateTime", "defaultValue": "CURRENT_TIMESTAMP"}
