            {"name": "idx_shop_order_user", "isUnique": false, "fields": ["user_id"]}
          ]
        },
        {
          "title": "shop_order_item",
          "chnname": "订单明细",
          "fields": [
            {"name": "id", "chnname": "主键", "type": "IdOrKey", "pk": true, "notNull": true},
            {"name": "order_id", "chnname": "订单", "type": "IdOrKey", "notNull": true},
            {"name": "product_id", "chnname": "商品", "type": "IdOrKey", "notNull": true},
            {"name": "quantity", "chnname": "数量", "type": "Integer", "notNull": true},
            {"name": "unit_price", "chnname": "单价", "type": "Money", "notNull": true}
          ],
          "indexs": [
            {"name": "idx_shop_order_item_order", "isUnique": false, "fields": ["order_id"]}
          ]
        }
      ],
      "associations": [
        {"relation": "1:n", "from": {"entity": "shop_product", "field": "category_id"}, "to": {"entity": "shop_category", "field": "id"}},
        {"relation": "1:n", "from": {"entity": "shop_order_item", "field": "order_id"}, "to": {"entity": "shop_order", "field": "id"}},
        {"relation": "1:n", "from": {"entity": "shop_order_item", "field": "product_id"}, "to": {"entity": "shop_product", "field": "id"}}
      ]
