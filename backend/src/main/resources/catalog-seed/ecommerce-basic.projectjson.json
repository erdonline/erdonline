            {"name": "sku", "chnname": "SKU", "type": "MiddleString", "notNull": true},
            {"name": "name", "chnname": "名称", "type": "MiddleString", "notNull": true},
            {"name": "price", "chnname": "价格", "type": "Money", "notNull": true, "defaultValue": "0"},
            {"name": "stock", "chnname": "库存", "type": "Integer", "defaultValue": "0"},
            {"name": "category_id", "chnname": "分类", "type": "IdOrKey"},
            {"name": "status", "chnname": "状态", "type": "ShortString", "defaultValue": "'active'"},
            {"name": "create_time", "chnname": "创建时间", "type": "DateTime", "defaultValue": "CURRENT_TIMESTAMP"}
