# ERD Online 单体自动配置汇总（合并自原各 common 模块的 spring.factories）
org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
  com.erdonline.common.core.support.SpringContextHelper,\
  com.erdonline.common.data.MartinDataAutoConfiguration,\
  com.erdonline.common.log.MartinLogAutoConfiguration,\
  com.erdonline.common.swagger.MartinSwaggerAutoConfiguration,\
  com.erdonline.common.oss.MartinOssAutoConfiguration,\
  com.erdonline.common.websocket.MartinSocketIoAutoConfiguration,\
  com.erdonline.common.social.MartinSocialLoginAutoConfiguration,\
  com.erdonline.common.vip.MartinVIPAutoConfiguration,\
  com.erdonline.common.vip.event.LicenceInstallListener,\
  com.erdonline.common.vip.event.LicenceListenerContainer,\
  com.erdonline.common.vip.license.LicenseCommandLineRunner,\
  com.erdonline.common.security.MartinSecurityAutoConfiguration,\
  com.erdonline.common.security.userdetail.MartinUserDetailsService,\
  com.erdonline.common.security.config.JacksonConfig,\
  com.erdonline.common.security.config.HttpSecurityDealer,\
  com.erdonline.common.security.exception.GlobalExceptionHandler,\
  com.erdonline.common.security.config.MybatisPlusConfiguration,\
  com.erdonline.common.security.component.MartinOauthResponseExceptionTranslator,\
  com.erdonline.erd.socketio.impl.ErdSocketIoServiceImpl
