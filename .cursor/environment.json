{
  "name": "ERD Online",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "bash .cursor/run-backend.sh"
    },
    {
      "name": "frontend",
      "command": "cd frontend && yarn start"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 8000 },
    { "name": "backend", "port": 9502 },
    { "name": "socketio", "port": 9092 }
  ]
}
